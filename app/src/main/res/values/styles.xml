<resources>
    <style name="Theme.Cyberpunk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyber_neon_purple</item>
        <item name="colorPrimaryVariant">@color/cyber_bg</item>
        <item name="colorOnPrimary">@color/cyber_text</item>
        <item name="colorSecondary">@color/cyber_neon_cyan</item>
        <item name="colorSecondaryVariant">@color/cyber_neon_magenta</item>
        <item name="colorOnSecondary">@color/cyber_bg</item>
        <item name="android:statusBarColor">@color/cyber_bg</item>
        <item name="android:navigationBarColor">@color/cyber_bg</item>
        <item name="android:windowBackground">@color/cyber_bg</item>
        <item name="android:colorAccent">@color/cyber_neon_cyan</item>
        <item name="android:colorPrimary">@color/cyber_neon_purple</item>
        <item name="android:colorPrimaryDark">@color/cyber_bg</item>
    </style>

    <style name="Theme.Cyberpunk.Splash" parent="Theme.Cyberpunk">
        <item name="android:windowBackground">@color/cyber_bg</item>
    </style>

    <style name="Theme.Cyberpunk.Lock" parent="Theme.Cyberpunk">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/cyber_bg</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="CyberpunkButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/cyber_text</item>
        <item name="backgroundTint">@color/cyber_neon_purple</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="CyberpunkCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cyber_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/cyber_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
