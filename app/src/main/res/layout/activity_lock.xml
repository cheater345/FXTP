<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg">

    <LinearLayout
        android:id="@+id/lockView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/cyber_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 FXTP"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/cyber_neon_magenta"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Locked"
            android:textSize="20sp"
            android:textColor="@color/cyber_neon_cyan"
            android:fontFamily="monospace"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:maxWidth="300dp"
            android:inputType="numberPassword"
            android:hint="Enter PIN"
            android:textColor="@color/cyber_text"
            android:textColorHint="@color/cyber_text_dim"
            android:background="@color/cyber_card"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:layout_gravity="center"/>

        <Button
            android:id="@+id/unlockBtn"
            style="@style/CyberpunkButton"
            android:text="🔓 Unlock"
            android:layout_width="match_parent"
            android:maxWidth="300dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyber_neon_magenta"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/cyber_bg" />

</FrameLayout>
